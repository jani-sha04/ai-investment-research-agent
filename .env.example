# --- LLM provider -----------------------------------------------------
# Choose "anthropic" (default) or "openai". Only the matching key below
# is required.
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Web search ---------------------------------------------------------
# Free tier available at https://tavily.com — this powers the agent's
# research step (company overview, financials, news, risks).
TAVILY_API_KEY=
